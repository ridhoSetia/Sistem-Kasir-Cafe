<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="309.0" prefWidth="249.0" spacing="15.0" styleClass="login-card" stylesheets="@../../../Downloads/mentahan/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.controller.LoginController">
    <children>
        <Label styleClass="title-label" text="Login">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TextField fx:id="inputUsername" promptText="Username" styleClass="text-field" />
        <PasswordField fx:id="inputPassword" promptText="Password" styleClass="text-field" />

        <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" styleClass="login-button" stylesheets="@../../../Downloads/mentahan/style.css" text="Login" />

        <Label fx:id="lblPesanError" text="." textFill="#2c3e50">
            <font>
                <Font name="System Italic" size="14.0" />
            </font>
        </Label>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
