<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.cafe.controller.HewanController">
    <children>
        <Label text="Input Data Hewan">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TextField fx:id="inputNama" promptText="Masukkan Nama Hewan (Contoh: Kucing)" />

        <TextField fx:id="inputUmur" promptText="Masukkan Umur Hewan (Angka)" />

        <Button fx:id="btnTambah" onAction="#onBtnClick" text="Buat Objek Hewan" maxWidth="Infinity"/>

        <Label text="Status Objek Saat Ini:">
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>
        
        <Label fx:id="labelDisplay" text="Belum ada data." textFill="#2c3e50">
            <font>
                <Font name="System Italic" size="14.0" />
            </font>
        </Label>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
