<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="ManajemenMenu" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" styleClass="bg-kasir" stylesheets="@../css/brew-society-pos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.controller.Manager.KelolaMenuController">
   
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Manajemen Data Menu Cafe" textFill="#610000">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="txtCariMenu" prefHeight="30.0" prefWidth="250.0" promptText="Cari nama menu atau kategori..." styleClass="search-bar" />
                  <Button fx:id="btnCariMenu" mnemonicParsing="false" onAction="#handleCariMenu" prefHeight="30.0" styleClass="btn-save" text="Cari" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </BorderPane.margin>
      </VBox>
   </top>

   <center>
      <TableView fx:id="tbMenu" prefHeight="400.0" prefWidth="500.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="tbCIDMenu" prefWidth="60.0" text="ID Menu" />
          <TableColumn fx:id="tbCNamaMenu" prefWidth="200.0" text="Nama Menu" />
          <TableColumn fx:id="tbCHargaMenu" prefWidth="120.0" text="Harga (Rp)" />
          <TableColumn fx:id="tbCKategoriMenu" prefWidth="120.0" text="Kategori" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </TableView>
   </center>

   <right>
      <VBox alignment="TOP_CENTER" prefWidth="160.0" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Aksi Kontrol" textFill="#460000">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>
            <Button fx:id="btnTambahMenu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleTambahMenu" styleClass="btn-save" text="Tambah Menu" />
            <Button fx:id="btnEditMenu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEditMenu" styleClass="btn-edit" text="Edit Menu" />
            <Button fx:id="btnHapusMenu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHapusMenu" styleClass="btn-cancel" text="Hapus Menu" />
         </children>
         <BorderPane.margin>
            <Insets bottom="15.0" left="5.0" right="15.0" top="5.0" />
         </BorderPane.margin>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
