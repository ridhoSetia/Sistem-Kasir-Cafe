<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="ManajemenAkunKasir" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" styleClass="page" stylesheets="@../css/brew-society-pos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.controller.Manager.KelolaAkunKasirController">
   
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER" styleClass="header-box">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Manajemen Akun Kasir" styleClass="page-title" />
                  <Label text="Kelola data kasir, tambah akun, dan ubah kredensial akses" styleClass="label-muted" />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="compact-card">
               <children>
                  <TextField fx:id="txtCariNamaAkunKasir" onAction="#handleCariKasir" prefHeight="38.0" prefWidth="280.0" promptText="Cari nama atau username kasir..." styleClass="text-field" />
                  <Button fx:id="btnCariAkunKasir" mnemonicParsing="false" onAction="#handleCariKasir" prefHeight="38.0" styleClass="btn-save" text="Cari Akun" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </BorderPane.margin>
      </VBox>
   </top>

   <center>
      <TableView fx:id="tbAkunKasir" prefHeight="400.0" prefWidth="530.0" BorderPane.alignment="CENTER" styleClass="table-view">
         <columns>
            <TableColumn fx:id="tbCIDAkunKasir" prefWidth="70.0" text="ID" />
            <TableColumn fx:id="tbCNamaAkunKasir" prefWidth="260.0" text="Nama Lengkap" />
            <TableColumn fx:id="tbCUsernameAkunKasir" prefWidth="180.0" text="Username" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets bottom="15.0" left="15.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </TableView>
   </center>

   <right>
      <VBox alignment="TOP_CENTER" prefWidth="170.0" spacing="12.0" BorderPane.alignment="CENTER" styleClass="card">
         <children>
            <Label text="Aksi Kontrol" styleClass="section-title">
               <VBox.margin>
                  <Insets bottom="6.0" />
               </VBox.margin>
            </Label>
            
            <Button fx:id="btnTambahAkunKasir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleTambahAkunKasir" styleClass="btn-add" text="Tambah Kasir" />
            <Button fx:id="btnEditAkunKasir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEditAkunKasir" styleClass="btn-edit" text="Edit Kasir" />
            <Button fx:id="btnHapusAkunKasir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHapusAkunKasir" styleClass="btn-delete" text="Hapus Kasir" />
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnKembaliMenu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleKembaliMenu" styleClass="btn-close" text="Kembali" />
         </children>
         <BorderPane.margin>
            <Insets bottom="15.0" left="5.0" right="15.0" top="5.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="16.0" left="14.0" right="14.0" top="16.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>