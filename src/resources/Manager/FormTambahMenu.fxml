<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="formTambahMenu" prefHeight="360.0" prefWidth="280.0" styleClass="dialog-card"
   stylesheets="@../css/brew-society-pos.css" xmlns="http://javafx.com/javafx/26"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.cafe.controller.Manager.FormTambahMenuController">
   <children>
      
      <Label fx:id="lblFormTitle" alignment="CENTER" prefHeight="39.0" prefWidth="230.0" styleClass="popup-title"
         stylesheets="@../css/brew-society-pos.css" text="Form Data Menu" textAlignment="CENTER">
         <VBox.margin>
            <Insets left="25.0" right="25.0" top="10.0" />
         </VBox.margin>
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Nama Menu">
         <VBox.margin>
            <Insets left="25.0" top="10.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtNamaMenuForm" prefHeight="30.0" prefWidth="230.0" promptText="Masukkan nama menu...">
         <VBox.margin>
            <Insets left="25.0" right="25.0" />
         </VBox.margin>
      </TextField>
      
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Harga (Rp)">
         <VBox.margin>
            <Insets left="25.0" top="10.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtHargaMenuForm" prefHeight="30.0" prefWidth="230.0" promptText="Contoh: 15000">
         <VBox.margin>
            <Insets left="25.0" right="25.0" />
         </VBox.margin>
      </TextField>
      
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Kategori">
         <VBox.margin>
            <Insets left="25.0" top="10.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="cmbKategoriMenuForm" prefHeight="30.0" prefWidth="230.0" promptText="-- Pilih Kategori --">
         <VBox.margin>
            <Insets left="25.0" right="25.0" />
         </VBox.margin>
      </ComboBox>
      
      <Label fx:id="lblFormStatus" alignment="CENTER" prefWidth="230.0" textFill="#ff3333">
         <VBox.margin>
            <Insets left="25.0" right="25.0" top="10.0" />
         </VBox.margin>
         <font>
            <Font size="11.0" />
         </font>
      </Label>
      
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="280.0" spacing="20.0">
         <children>
            <Button fx:id="btnBatalFormMenu" alignment="CENTER" contentDisplay="CENTER"
               mnemonicParsing="false" onAction="#handleBatalFormMenu"
               styleClass="btn-cancel" stylesheets="@../css/brew-society-pos.css" text="Batal"
               textAlignment="CENTER" prefWidth="90.0" />
            <Button fx:id="btnSimpanFormMenu" alignment="CENTER" contentDisplay="CENTER"
               mnemonicParsing="false" onAction="#handleSimpanFormMenu" styleClass="btn-save"
               stylesheets="@../css/brew-society-pos.css" text="Simpan" prefWidth="90.0" />
         </children>
         <VBox.margin>
            <Insets top="15.0" bottom="15.0" />
         </VBox.margin>
      </HBox>
      
   </children>
</VBox>