<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="formTambahKasir" prefHeight="342.0" prefWidth="240.0" styleClass="dialog-card"
   stylesheets="@../css/brew-society-pos.css" xmlns="http://javafx.com/javafx/26"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="com.cafe.controller.Manager.FormTambahKasirController">
   <children>
      <Label alignment="CENTER" prefHeight="39.0" prefWidth="156.0" styleClass="popup-title"
         stylesheets="@../css/brew-society-pos.css" text="Form Data Kasir" textAlignment="CENTER">
         <VBox.margin>
            <Insets left="25.0" />
         </VBox.margin>
      </Label>
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Nama Lengkap" />
      <TextField fx:id="txtNamaFormTambahKasir"
         prefHeight="11.0" prefWidth="151.0" />
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Username" />
      <TextField fx:id="txtUsernameFormTambahKasir"
         prefHeight="11.0" prefWidth="151.0" />
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Password" />
      <PasswordField fx:id="txtPasswordFormTambahKasir" />
      <Label alignment="CENTER" styleClass="label-muted" stylesheets="@../css/brew-society-pos.css"
         text="Konfirmasi Password" />
      <PasswordField fx:id="txtKonfirPasswordFormTambahKasir" />
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button fx:id="btnBatalFormTambahKasir" alignment="CENTER" contentDisplay="CENTER"
               mnemonicParsing="false" onAction="#handleBatalFormTambahKasir"
               styleClass="btn-cancel" stylesheets="@../css/brew-society-pos.css" text="Batal"
               textAlignment="CENTER">
               <HBox.margin>
                  <Insets left="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnSimpanFormTambahKasir" alignment="CENTER" contentDisplay="CENTER"
               mnemonicParsing="false" onAction="#handleSimpanFormTambahKasir" styleClass="btn-save"
               stylesheets="@../css/brew-society-pos.css" text="Simpan">
               <HBox.margin>
                  <Insets left="25.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>