<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="KelolaPembayaran"
      alignment="TOP_CENTER"
      maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="580.0"
      prefWidth="620.0"
      spacing="0"
      stylesheets="@../css/brew-society-pos.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cafe.controller.Kasir.KelolaPembayaranController">

   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="620.0" styleClass="header-bar">
         <padding>
            <Insets left="20.0" right="20.0" top="12.0" bottom="12.0" />
         </padding>
         <children>
            <ImageView fitHeight="52.0" fitWidth="52.0"
                       pickOnBounds="true" preserveRatio="true"
                       styleClass="logo-circle">
               <image>
                  <Image url="@image/iava.png" />
               </image>
            </ImageView>

            <Label text="Kelola Pembayaran"
                   styleClass="page-title"
                   prefHeight="52.0">
               <HBox.margin>
                  <Insets left="14.0" />
               </HBox.margin>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnTambahKeranjang"
                    text="+ Tambah Pesanan"
                    styleClass="btn-add"
                    mnemonicParsing="false"
                    onAction="#handleTambahKeranjang"
                    prefHeight="38.0"
                    prefWidth="160.0" />
         </children>
      </HBox>

      <Separator />

      <TableView fx:id="tbKelolaPembayaran"
                 prefHeight="260.0"
                 prefWidth="620.0"
                 VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="tbCGambarKelolaPembayaran"
                         prefWidth="70.0" text="Gambar" />
            <TableColumn fx:id="tbCNamaMenuKelolaPembayaran"
                         prefWidth="180.0" text="Nama Menu" />
            <TableColumn fx:id="tbCHargaSatuanKelolaPembayaran"
                         prefWidth="120.0" text="Harga Satuan" />
            <TableColumn fx:id="tbCJumlahKelolaPembayaran"
                         prefWidth="80.0" text="Jumlah" />
            <TableColumn fx:id="tbCSubtotalKelolaPembayaran"
                         prefWidth="120.0" text="Subtotal" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </TableView>

      <Separator />

      <HBox prefWidth="620.0" spacing="0" styleClass="summary-panel">
         <padding>
            <Insets top="18.0" bottom="18.0" left="24.0" right="24.0" />
         </padding>
         <children>

            <VBox spacing="10.0" prefWidth="200.0">
               <children>
                  <Label text="Total" styleClass="summary-key" />
                  <Label text="Nominal Bayar" styleClass="summary-key" />
                  <Label text="Kembalian" styleClass="summary-key" />
               </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <VBox spacing="8.0" prefWidth="220.0" alignment="CENTER_RIGHT">
               <children>
                  <Label fx:id="lblTotalKelolaPembayaran"
                         text="Rp. -"
                         styleClass="summary-value"
                         prefHeight="30.0"
                         prefWidth="220.0" />

                  <TextField fx:id="txtNominalBayarKelolaPembayaran"
                             promptText="Masukkan nominal..."
                             prefHeight="36.0"
                             prefWidth="220.0"
                             styleClass="input-nominal" />

                  <Label fx:id="lblKembalianKelolaPembayaran"
                         text="Rp. -"
                         styleClass="summary-value"
                         prefHeight="30.0"
                         prefWidth="220.0" />

                  <Label text="⚠ Uang tidak cukup"
                         styleClass="error-label"
                         visible="false"
                         prefHeight="22.0" />

                  <Button fx:id="btnBayarKelolaPembayaran"
                          text="Bayar Sekarang"
                          mnemonicParsing="false"
                          onAction="#handleBayar"
                          prefHeight="40.0"
                          prefWidth="220.0">
                     <VBox.margin>
                        <Insets top="4.0" />
                     </VBox.margin>
                     <styleClass>
                        <String fx:value="btn-pay" />
                        <String fx:value="btn-md" />
                     </styleClass>
                  </Button>
               </children>
            </VBox>

         </children>
      </HBox>

   </children>
</VBox>